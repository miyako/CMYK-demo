					"style": "regular"
				},
				"ScenarioSummary": {
					"type": "input",
					"left": 644,
					"top": 918,
					"width": 368,
					"height": 20,
					"dataSource": "Form.scenarioSummary",
					"dataSourceTypeHint": "text",
					"enterable": false,
